# ==========================================
# AYEZA COSMETICS — Production (Netlify)
# ==========================================
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# These are ALSO set in Netlify Dashboard → Site Settings → Environment Variables
# (dashboard values override this file for SSR/ISR at runtime).

# Railway backend — do NOT change this
NEXT_PUBLIC_API_URL=https://ayezacosmetics-production.up.railway.app/api

# ⚠️  Update to your real Netlify URL after first deploy
# e.g. https://amazing-jelly-123.netlify.app  OR  https://www.ayezacosmetics.com
NEXT_PUBLIC_APP_URL=https://ayeza-cosmetics.netlify.app

NEXT_PUBLIC_APP_NAME="AYEZA COSMETICS"

