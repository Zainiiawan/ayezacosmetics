# ==========================================
# AYEZA COSMETICS — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ------------------------------------------
# API Server
# ------------------------------------------
NODE_ENV=development
PORT=5001
API_URL=http://localhost:5001

# ------------------------------------------
# Frontend
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AYEZA COSMETICS"

# ------------------------------------------
# MongoDB Atlas
# ------------------------------------------
# Create a free cluster at https://cloud.mongodb.com
# Database Access → create user | Network Access → allow 0.0.0.0/0 (or your IPs)
# Connect → Drivers → copy URI, then replace <password> and set the DB name.
# Example shape (DO NOT commit real credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ayezacosmetics?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ayezacosmetics?retryWrites=true&w=majority&appName=Cluster0

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# Google OAuth 2.0
# ------------------------------------------
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------
# Cloudinary (Media Storage)
# ------------------------------------------
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------
# Stripe (Payments)
# ------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ------------------------------------------
# JazzCash (Pakistani Payment Gateway)
# ------------------------------------------
# Get from: https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_jazzcash_password
JAZZCASH_INTEGRITY_SALT=your_integrity_salt
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction
JAZZCASH_RETURN_URL=http://localhost:5000/api/payments/jazzcash/callback

# ------------------------------------------
# Easypaisa (Pakistani Payment Gateway)
# ------------------------------------------
# Get from: https://sandbox.easypaisa.com.pk
EASYPAISA_STORE_ID=your_store_id
EASYPAISA_HASH_KEY=your_hash_key
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/tpay
EASYPAISA_RETURN_URL=http://localhost:5000/api/payments/easypaisa/callback

# ------------------------------------------
# Email (SMTP)
# ------------------------------------------
# For Gmail: use App Password from https://myaccount.google.com/apppasswords
# Or use SendGrid: https://sendgrid.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="AYEZA COSMETICS <noreply@ayezacosmetics.com>"

# ------------------------------------------
# Frontend Public Keys
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------
# Security
# ------------------------------------------
CORS_ORIGIN=http://localhost:3000
# Railway / production: set to your Vercel URL (comma-separated allowed)
# CORS_ORIGIN=https://your-app.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# Railway API (required runtime vars)
# ------------------------------------------
# HOST=0.0.0.0
# PORT is injected by Railway automatically
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ayezacosmetics?retryWrites=true&w=majority
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# SESSION_SECRET=
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=

# ------------------------------------------
# Session
# ------------------------------------------
SESSION_SECRET=your_session_secret_here_change_in_production

# ------------------------------------------
# Admin
# ------------------------------------------
ADMIN_EMAIL=admin@ayezacosmetics.com
ADMIN_PASSWORD=Admin@123!

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=debug
LOG_FILE=logs/app.log
