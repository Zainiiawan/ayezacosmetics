# ==========================================
# AYEZA COSMETICS — Production (Vercel)
# ==========================================
# NEXT_PUBLIC_* vars are baked into the bundle at build time.
# This file ensures the correct Railway API URL is always used
# on Vercel even if the dashboard env var is not set.
NEXT_PUBLIC_API_URL=https://ayezacosmetics-production.up.railway.app/api
NEXT_PUBLIC_APP_URL=https://ayezacosmetics-web.vercel.app
NEXT_PUBLIC_APP_NAME="AYEZA COSMETICS"
